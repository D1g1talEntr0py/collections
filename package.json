{
  "name": "@d1g1tal/collections",
  "author": "D1g1talEntr0py",
  "version": "3.2.2",
  "license": "MIT",
  "description": "JavaScript Collections ES Modules",
  "homepage": "https://github.com/D1g1talEntr0py/collections#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1g1talEntr0py/collections.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/collections/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=20.16.0"
  },
  "packageManager": "pnpm@12.5.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsbuild",
    "build:watch": "tsbuild --watch",
    "type-check": "tsbuild --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "pnpm build && node --expose-gc tests/benchmark/collections.benchmark.ts"
  },
  "devDependencies": {
    "@d1g1tal/tsbuild": "^3.0.2",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^64.5.4",
    "globals": "^17.12.0",
    "mitata": "^1.0.34",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.1"
  },
  "browserslist": [
    "defaults and fully supports es6",
    "maintained node versions"
  ],
  "keywords": [
    "Collections",
    "Data Structures",
    "ESModules"
  ]
}
